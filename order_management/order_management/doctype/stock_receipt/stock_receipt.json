{
  "doctype": "DocType",
  "name": "Stock Receipt",
  "module": "Order Management",
  "engine": "InnoDB",
  "autoname": "format:IN-{#####}",
  "field_order": ["item", "quantity", "balance_after", "note"],
  "fields": [
    {"fieldname": "item", "fieldtype": "Link", "options": "Stock Item", "label": "Mặt hàng", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "quantity", "fieldtype": "Float", "label": "Số lượng nhập", "precision": "3", "reqd": 1, "in_list_view": 1},
    {"fieldname": "balance_after", "fieldtype": "Float", "label": "Tồn sau khi nhập", "precision": "3", "read_only": 1, "in_list_view": 1},
    {"fieldname": "note", "fieldtype": "Small Text", "label": "Ghi chú"}
  ],
  "permissions": [
    {"role": "Administrator", "create": 1, "read": 1, "write": 1, "print": 1},
    {"role": "Order Warehouse", "create": 1, "read": 1, "write": 1, "print": 1}
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
